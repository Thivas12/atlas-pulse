# All defaults run locally without paid services. NASA FIRMS is opt-in with a free key.
ATLAS_ENVIRONMENT=development
ATLAS_LOG_LEVEL=INFO
ATLAS_USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson
ATLAS_USGS_POLL_SECONDS=60
ATLAS_NWS_ALERTS_URL=https://api.weather.gov/alerts/active?status=actual
# NWS responses are much larger than USGS; two minutes balances freshness and local storage.
ATLAS_NWS_POLL_SECONDS=120
# NASA FIRMS distributes satellite fire/thermal-anomaly detections. Request a free MAP_KEY at:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
ATLAS_FIRMS_ENABLED=false
ATLAS_FIRMS_MAP_KEY=
ATLAS_FIRMS_PRODUCT=VIIRS_NOAA20_NRT
# Use "world" or a non-wrapping west,south,east,north WGS84 bbox.
ATLAS_FIRMS_AREA=world
ATLAS_FIRMS_DAY_RANGE=1
# Global NRT data can lag an overpass by up to ~3 hours; a 15-minute poll avoids needless load.
ATLAS_FIRMS_POLL_SECONDS=900
ATLAS_FIRMS_ACTIVE_WINDOW_HOURS=24
# GDELT 2.0 publishes a key-free global Event export every 15 minutes. AtlasPulse keeps only
# root-level, city/landmark-or-better material-conflict observations in the live view by default.
ATLAS_GDELT_ENABLED=true
ATLAS_GDELT_LAST_UPDATE_URL=https://data.gdeltproject.org/gdeltv2/lastupdate.txt
ATLAS_GDELT_POLL_SECONDS=900
ATLAS_GDELT_ACTIVE_WINDOW_HOURS=24
ATLAS_GDELT_ONLY_ROOT_EVENTS=true
ATLAS_GDELT_MINIMUM_GEO_PRECISION=3
ATLAS_GDELT_MINIMUM_MENTIONS=1
ATLAS_GDELT_MAX_COMPRESSED_BYTES=25000000
ATLAS_GDELT_MAX_UNCOMPRESSED_BYTES=100000000
ATLAS_GDELT_MAX_ROWS=100000
ATLAS_GDELT_MAX_EVENTS=5000
# NWS requires an identifiable User-Agent. Keep a public project/contact URL here.
ATLAS_SOURCE_USER_AGENT=AtlasPulse/0.5 (+https://github.com/Thivas12/atlas-pulse)
ATLAS_SOURCE_TIMEOUT_SECONDS=15
ATLAS_SOURCE_MAX_ATTEMPTS=3
ATLAS_RAW_DATA_DIR=data/raw
ATLAS_VALKEY_URL=valkey://localhost:6379/0
ATLAS_EVENT_STREAM={atlas}:events
ATLAS_STREAM_MAX_LENGTH=100000
ATLAS_DEDUPE_TTL_SECONDS=604800
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas
ATLAS_PROJECTION_NAME=current-signals-v1
ATLAS_PROJECTION_BATCH_SIZE=500
ATLAS_PROJECTION_POLL_SECONDS=1
ATLAS_OTEL_SERVICE_NAME=atlas-pulse
# Optional: point this at a self-hosted OpenTelemetry collector.
# ATLAS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
